{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "react-router-starter-template",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
	},
	"r2_buckets": [
		{
			"binding": "ART_BUCKET",
			"bucket_name": "art-uploads"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "BATTLE_ROOM",
				"class_name": "BattleRoom"
			},
			{
				"name": "GUESS_ROOM",
				"class_name": "GuessRoom"
			},
			{
				"name": "FAKE_ROOM",
				"class_name": "FakeArtistRoom"
			},
			{
				"name": "SQUIGGLE_ROOM",
				"class_name": "SquiggleRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"BattleRoom"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"GuessRoom"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"FakeArtistRoom"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"SquiggleRoom"
			]
		}
	]
}
